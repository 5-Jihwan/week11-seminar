/* 되감기: 슬라이더 시각 t까지의 제출(기기별 최신) + 아직 안 낸 기기의 초안 */
function rewind(t){const sub=dedupe(allRows.filter(r=>r.ts<=t)),devs=new Set(sub.map(r=>r.dev)),by={};drafts.filter(d=>d.ts<=t&&!devs.has(d.dev)).forEach(d=>{by[d.dev]=d;});
  const dr=Object.values(by).map(d=>({...d,nickShown:(d.nick||'작업 중')+' ⋯',value:d.value}));drawNet([...sub,...dr]);$('rwlab').textContent=new Date(t).toLocaleTimeString('ko-KR')+` · 제출 ${sub.length} · 작업 중 ${dr.length}`;}
function setupRewind(){const ts=[...allRows,...drafts].map(r=>r.ts).sort();const s=$('rw');if(!ts.length){s.disabled=true;$('rwlab').textContent='기록 없음';return;}s.disabled=false;s.min=new Date(ts[0]).getTime()-1000;s.max=Date.now();if(!s.dataset.touched)s.value=s.max;s.oninput=()=>{s.dataset.touched=1;rewind(+s.value);};$('rwnow').onclick=()=>{delete s.dataset.touched;s.value=s.max;drawNet();$('rwlab').textContent='지금';};}
const _render=render;render=function(){_render();setupRewind();if($('rw').dataset.touched)rewind(+$('rw').value);else drawNet();};let _rt=null;window.addEventListener('resize',()=>{clearTimeout(_rt);_rt=setTimeout(()=>drawNet(),150);});
window.addEventListener('storage',e=>{if(e.key==='w11_model'||e.key==='w11_draft')load();});setInterval(()=>{if(READ_URL)load();},10000);load();
</script></body></html>
