<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Galpi Admin · 사회자본 11주차</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/static/pretendard.css">
<style>
*{box-sizing:border-box;margin:0;padding:0}body{font-family:Pretendard,-apple-system,'Segoe UI','Malgun Gothic',sans-serif;background:#f1f5f9;color:#0f172a;min-height:100vh}
.topbar{height:52px;background:rgba(250,250,247,.92);backdrop-filter:blur(12px);border-bottom:1px solid rgba(0,0,0,.06);display:flex;align-items:center;gap:8px;padding:0 16px;position:sticky;top:0;z-index:5}
.brand{display:flex;align-items:center;gap:8px;font-weight:700;font-size:14px;letter-spacing:-.02em;color:#022448}.brand .dot{width:20px;height:20px;border-radius:6px;background:linear-gradient(135deg,#022448,#006a61)}.badge{padding:3px 10px;border-radius:999px;font-size:10.5px;font-weight:700;letter-spacing:.04em;background:#f0fdf8;color:#006a61;border:1px solid #99f6e4}
.right{margin-left:auto;display:flex;align-items:center;gap:10px}.rbtn{height:30px;padding:0 12px;border:1px solid #d8dbe1;border-radius:999px;color:#434a56;background:#fff;font-size:12px;cursor:pointer;font-weight:600;font-family:inherit}.rbtn:hover{background:#f3f3ee}.rbtn.dark{background:#022448;color:#fff;border-color:#022448}.live{font-size:11px;color:#5c626d;display:flex;align-items:center;gap:6px}.live i{width:8px;height:8px;border-radius:50%;background:#4ade80;display:inline-block;animation:bl 1.4s infinite}@keyframes bl{50%{opacity:.3}}
.content{max-width:1240px;margin:0 auto;padding:24px}
.stats{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin-bottom:24px}.stat{background:#fff;border-radius:12px;padding:18px 16px;border-top:3px solid transparent}.stat.blue{border-top-color:#3b82f6}.stat.purple{border-top-color:#8b5cf6}.stat.green{border-top-color:#16a34a}.stat.amber{border-top-color:#f59e0b}.stat.red{border-top-color:#ef4444}.stat.gray{border-top-color:#94a3b8}
.num{font-size:32px;font-weight:900;line-height:1;margin-bottom:4px}.blue .num{color:#3b82f6}.purple .num{color:#8b5cf6}.green .num{color:#16a34a}.amber .num{color:#f59e0b}.red .num{color:#ef4444}.gray .num{color:#94a3b8}.lab{font-size:11px;color:#64748b;font-weight:600}
.sh{display:flex;align-items:center;gap:10px;margin-bottom:12px}.st{font-size:14px;font-weight:800;color:#1e3a5f}.sc{font-size:11px;background:#e0e7ff;color:#4338ca;padding:2px 8px;border-radius:99px;font-weight:700}
.two{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}.three{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-bottom:24px}@media(max-width:900px){.two,.three{grid-template-columns:1fr}}
.card{background:#fff;border-radius:10px;padding:14px 16px;border:1px solid #e2e8f0}
.bar{display:flex;align-items:center;gap:8px;margin:5px 0;font-size:12px}.bar span{width:150px;color:#334155;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.bar i{display:block;height:14px;border-radius:3px;background:linear-gradient(90deg,#1e3a5f,#3b82f6);min-width:2px}.bar b{color:#1e3a5f;font-size:12px}
.grid{width:100%;border-collapse:collapse;font-size:12px}.grid th,.grid td{border:1px solid #e2e8f0;padding:8px 6px;text-align:center}.grid th{background:#f8fafc;color:#64748b;font-size:10.5px;font-weight:800}.grid td.z{background:#f0fdf4;color:#16a34a;font-weight:700}.grid td.n{background:#eff6ff;font-weight:700;color:#1d4ed8}
.tbl{width:100%;border-collapse:collapse;font-size:12px;background:#fff;border-radius:10px;overflow:hidden;border:1px solid #e2e8f0}.tbl th{background:#f8fafc;padding:10px 12px;text-align:left;font-size:10.5px;font-weight:800;color:#64748b;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #e2e8f0}.tbl td{padding:9px 12px;border-bottom:1px solid #f1f5f9;vertical-align:top}.tbl tr:hover td{background:#f8fafc;cursor:pointer}.tbl tr.new td{animation:hl 2s}@keyframes hl{from{background:#fef9c3}}
.pill{font-size:10px;font-weight:800;padding:2px 7px;border-radius:5px;white-space:nowrap}.p-kr{background:#fee2e2;color:#b91c1c}.p-fr{background:#dbeafe;color:#1d4ed8}.p-lw{background:#dcfce7;color:#15803d}.p-me{background:#fef3c7;color:#b45309}.p-kn{background:#ede9fe;color:#6d28d9}.p-out{background:#f3f4f6;color:#6b7280}
.empty{text-align:center;padding:48px 20px;background:#fff;border-radius:10px;color:#94a3b8;font-size:13px;border:1px dashed #e2e8f0}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.4);display:none;align-items:center;justify-content:center;z-index:50;padding:20px}.modal.on{display:flex}.mbox{background:#fff;border-radius:16px;width:min(1000px,100%);max-height:92vh;overflow-y:auto;padding:22px 26px;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.mh{display:flex;align-items:center;gap:12px;margin-bottom:12px}.mh h2{font-size:18px;color:#1e3a5f}.mh .x{margin-left:auto;border:0;background:none;font-size:22px;cursor:pointer;color:#64748b}
.diag{position:relative;height:300px;background:#fafaf7;background-image:radial-gradient(circle at 2px 2px,rgba(60,64,75,.18) 1px,transparent 0);background-size:28px 28px;border-radius:12px;border:1px solid #e2e8f0;overflow:hidden;margin-bottom:14px}
.nd{position:absolute;min-width:118px;max-width:170px;padding:8px 14px;text-align:center;border-radius:10px;border:1.5px solid;font-size:12px;font-weight:700}.nd.IV{background:linear-gradient(160deg,#fff,#d5e3ff);border-color:#adc8f5;color:#1e3a5f}.nd.MV{background:linear-gradient(160deg,#fff,#b4f5ec);border-color:#6bd8cb;color:#006a61}.nd.DV{background:linear-gradient(160deg,#fff,#e9d5ff);border-color:#c084fc;color:#6d28d9}.nd.CV{background:linear-gradient(160deg,#fff,#e5e7eb);border-color:#d1d5db;color:#374151}.nd.ZV{background:linear-gradient(160deg,#fff,#fde68a);border-color:#f59e0b;color:#92400e;border-style:dashed}.nd small{display:block;font-size:8.5px;font-family:monospace;opacity:.6;font-weight:800;letter-spacing:.1em}
.def{padding:10px 12px;border-radius:10px;background:#f0f4ff;border:1px solid #c7d2fe;font-size:13px;line-height:1.6;color:#1e3a5f;margin-bottom:10px}.k{font-size:11px;color:#64748b;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin:12px 0 6px}
.study{border:1px solid #e2e8f0;border-radius:8px;padding:8px 10px;margin-bottom:6px;font-size:12px}.study b{display:block}
.hint{font-size:11px;color:#94a3b8;margin-top:6px}
</style></head><body>
<div class="topbar"><div class="brand"><div class="dot"></div><span>사회자본 연구모형</span></div><span class="badge">2부 · 관리자</span>
  <div class="right"><span class="live"><i></i>실시간 <span id="src">이 브라우저(데모)</span></span><span style="font-size:11px;color:#8b919c" id="last">–</span><button class="rbtn" id="demo">시연용 학생 17명 생성</button><button class="rbtn" id="clear">비우기</button><button class="rbtn dark" id="proj">프로젝터 모드</button></div></div>
<div class="content">
  <div class="stats" id="stats"></div>
  <div class="three">
    <div><div class="sh"><span class="st">어떤 자료를 썼나</span><span class="sc" id="c1"></span></div><div class="card" id="bySurvey"></div></div>
    <div><div class="sh"><span class="st">사회자본을 무엇으로 정의했나</span><span class="sc" id="c2"></span></div><div class="card" id="byComp"><div class="hint">정의 구성 요소(중복 집계)</div></div></div>
    <div><div class="sh"><span class="st">분류 틀의 어느 칸인가</span><span class="sc" id="c3"></span></div><div class="card" id="byLin"></div><div class="sh" style="margin-top:14px"><span class="st">개념화: 무엇이라 말했나</span></div><div class="card" id="byConcept"></div></div>
  </div>
  <div class="two">
    <div><div class="sh"><span class="st">종속 구성 × 독립 묶음</span><span class="sc">빈 칸 = 연구 빈자리</span></div><div class="card" id="grid"></div></div>
    <div><div class="sh"><span class="st">원인으로 무엇을 뒀나</span></div><div class="card" id="byIv"></div><div class="sh" style="margin-top:14px"><span class="st">1부 다섯 편이 잰 것</span></div><div class="card" id="papers"></div></div>
  </div>
  <div class="sh"><span class="st">선행연구 그물망 · 17명은 어디에 있나</span><span class="sc" id="netc"></span><span style="font-size:11px;color:#94a3b8">점 = 선행연구 346편(규칙 코딩·미검수) · 선 = 같은 구성 요소·같은 원인 축인 이웃 4편 · 금색 = 제출된 모형 · 끌면 회전, 휠로 확대, 점을 누르면 원문</span></div>
  <div class="card" style="display:flex;align-items:center;gap:10px;margin-bottom:8px;font-size:12px"><button class="rbtn" id="netauto">회전 멈춤</button><span style="font-weight:700;color:#1e3a5f">되감기</span><input type="range" id="rw" style="flex:1" min="0" max="100" value="100"><span id="rwlab" style="color:#64748b;min-width:200px">지금</span><button class="rbtn" id="rwnow">지금으로</button></div>
  <div class="card" style="padding:0;margin-bottom:24px;position:relative"><canvas id="net" style="width:100%;height:520px;display:block;border-radius:10px"></canvas><div id="nettip" style="position:absolute;display:none;background:#0f172a;color:#fff;font-size:11.5px;padding:6px 10px;border-radius:6px;pointer-events:none;max-width:320px;line-height:1.5"></div>
    <div style="position:absolute;left:12px;bottom:10px;display:flex;gap:10px;font-size:11px;color:#475569;background:rgba(255,255,255,.85);padding:4px 8px;border-radius:6px"><span><i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#1e3a5f"></i> 제도 중심</span><span><i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#0d9488"></i> 사회 중심</span><span><i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#16a34a"></i> 지역 맥락</span><span><i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:#94a3b8"></i> 개인·미상</span><span><i style="display:inline-block;width:7px;height:7px;border-radius:50%;background:#cbd5e1"></i> 미코딩(바깥)</span><span><i style="display:inline-block;width:11px;height:11px;border-radius:50%;background:#f59e0b;border:2px solid #b45309"></i> 학생 모형</span></div></div>
  <div class="sh"><span class="st">제출된 연구모형</span><span class="sc" id="cnt"></span><span style="font-size:11px;color:#94a3b8">행을 누르면 크게 봅니다 (spotlight)</span></div>
  <div id="list"></div>
</div>
<div class="modal" id="modal"><div class="mbox" id="mbox"></div></div>
<script>
// READ_URL: backend/apps-script.gs 웹앱 주소(캔버스 SAVE_URL과 같은 값). 있으면 10초마다 시트를 읽고, 없으면 이 브라우저 localStorage만 본다.
const CAT=__CAT__, PAPERS=__PAPERS__, STUDIES=__STUDIES__, READ_URL="";
const S=CAT.surveys,C=CAT.concepts,IT=CAT.items,cname=id=>(C.find(c=>c.id===id)||{}).label||id,sname=k=>(S[k]||{}).name||k;
const COMP_KO={generalized_trust:"일반신뢰",institutional_trust:"기관신뢰",neighbor_trust:"이웃 신뢰",participation:"단체 참여",volunteer_donate:"봉사·기부",network:"연결망",reciprocity:"호혜",political_participation:"정치 참여"};
const LIN=l=>!l?'':/제도 중심/.test(l)?'p-fr':/사회 중심/.test(l)?'p-lw':/개인 자원/.test(l)?'p-me':/지역 맥락/.test(l)?'p-kn':'p-out';
let rows=[],allRows=[],drafts=[],seen=new Set(),DEMO=true,esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
const LS=k=>{try{return JSON.parse(localStorage.getItem(k)||'[]');}catch(e){return [];}};
/* 같은 기기(dev)에서 다시 낸 것은 최신 하나만. dev가 없으면 별명으로. 같은 별명·다른 기기는 (2)를 붙인다. */
function dedupe(a){const by={};a.filter(r=>r.stage==='model'&&r.value).forEach(r=>{by[r.dev||('n:'+r.nick)]=r;});const out=Object.values(by).sort((x,y)=>x.ts<y.ts?-1:1),seenN={};out.forEach(r=>{const n=r.nick||'–';seenN[n]=(seenN[n]||0)+1;r.nickShown=seenN[n]>1?`${n} (${seenN[n]})`:n;});return out;}
function load(){allRows=LS('w11_model');drafts=LS('w11_draft');if(READ_URL){Promise.all([fetch(READ_URL+'?stage=model').then(r=>r.json()),fetch(READ_URL+'?stage=draft').then(r=>r.json())]).then(([m,d])=>{allRows=m;drafts=d;rows=dedupe(allRows);render();}).catch(()=>{});}rows=dedupe(allRows);render();}
function count(arr){const c={};arr.forEach(k=>{if(k)c[k]=(c[k]||0)+1});return Object.entries(c).sort((a,b)=>b[1]-a[1]);}
function bars(el,pairs,label){const mx=Math.max(1,...pairs.map(p=>p[1]));el.innerHTML=(pairs.length?pairs.map(([k,v])=>`<div class="bar"><span title="${label(k)}">${label(k)}</span><i style="width:${v/mx*100}%;max-width:220px"></i><b>${v}</b></div>`).join(''):'<div class="hint">아직 없음</div>')+(el.id==='byComp'?'<div class="hint">정의 구성 요소(중복 집계)</div>':'');}
function render(){const n=rows.length,sv=count(rows.map(r=>r.value.survey)),cp=count(rows.flatMap(r=>r.value.comps||[])),ln=count(rows.map(r=>r.value.lineage)),iv=count(rows.flatMap(r=>r.value.iv||[]));
  const multi=rows.filter(r=>(r.value.comps||[]).length>1).length,med=rows.filter(r=>r.value.med).length,ql=rows.filter(r=>/영향/.test(r.value.q||'')).length;
  const gapok=rows.filter(r=>r.value.gap_ok).length,zv=rows.filter(r=>(r.value.zv||[]).length).length,working=new Set(drafts.map(d=>d.dev)).size-new Set(rows.map(r=>r.dev)).size;
  $('stats').innerHTML=[['blue',n,'제출된 모형'],['gray',Math.max(0,working),'아직 작업 중(초안만 있음)'],['purple',sv.length,'쓰인 자료 종류'],['green',gapok,'개념대로 쟀다(개념·측정 일치)'],['green',multi,'문항을 2개 이상 묶어 정의'],['amber',med,'매개를 넣음'],['amber',zv,'집단 비교(조절)를 넣음'],['gray',ql,'연구질문에 "영향"']].map(([c,v,l])=>`<div class="stat ${c}"><div class="num">${v}</div><div class="lab">${l}</div></div>`).join('');
  $('c1').textContent=n;$('c2').textContent=cp.reduce((a,b)=>a+b[1],0);$('c3').textContent=n;bars($('bySurvey'),sv,sname);bars($('byComp'),cp,k=>COMP_KO[k]||k);bars($('byLin'),ln,k=>k);bars($('byIv'),iv,cname);
  bars($('byConcept'),count(rows.map(r=>r.value.concept?`${({cognitive:'인지적',structural:'구조적',both:'둘 다'})[r.value.concept.dim]||'?'} · ${r.value.concept.level==='collective'?'공동체':'개인'}`:'')),k=>k);
  $('papers').innerHTML=PAPERS.map(p=>`<div class="bar"><span><b>${p[0]}</b></span><span style="width:auto;flex:1;white-space:normal">${p[1]}</span></div>`).join('');
  const comps=['generalized_trust','institutional_trust','neighbor_trust','participation','volunteer_donate','reciprocity','political_participation'],ivs=['welfare_selective','welfare_universal','public_service_experience','institution_participation','region'];
  $('grid').innerHTML=`<table class="grid"><tr><th></th>${ivs.map(i=>`<th>${cname(i).slice(0,6)}</th>`).join('')}</tr>`+comps.map(c=>`<tr><th style="text-align:left">${COMP_KO[c]}</th>${ivs.map(i=>{const v=rows.filter(r=>(r.value.comps||[]).includes(c)&&(r.value.iv||[]).includes(i)).length;return `<td class="${v?'n':'z'}">${v||'·'}</td>`}).join('')}</tr>`).join('')+`</table>`;
  $('cnt').textContent=n;$('last').textContent='갱신: '+new Date().toLocaleTimeString('ko-KR');
  $('list').innerHTML=n?`<table class="tbl"><tr><th>#</th><th>별명</th><th>자료</th><th>개념</th><th>정의(측정)</th><th>원인 묶음</th><th>매개·조절</th><th>변수·경로</th><th>칸</th><th>시각</th></tr>`+rows.map((r,i)=>`<tr data-i="${i}" class="${seen.has(r.ts)?'':'new'}"><td style="color:#94a3b8">${i+1}</td><td><b>${esc(r.nickShown||r.nick||'–')}</b>${r.verdict?` <span class="pill p-lw">${esc(r.verdict)}</span>`:''}</td><td>${sname(r.value.survey).slice(0,9)}</td><td>${r.value.concept?({cognitive:'인지',structural:'구조',both:'둘 다'})[r.value.concept.dim]+'·'+(r.value.concept.level==='collective'?'공동체':'개인'):'–'} ${r.value.gap_ok===false?'<span class="pill p-me">어긋남</span>':''}</td><td>${esc(r.value.dv_name||'')} <span style="color:#64748b">(${(r.value.comps||[]).map(c=>COMP_KO[c]).join('·')||'–'})</span></td><td>${(r.value.iv||[]).map(cname).join(', ')||'–'}</td><td>${r.value.med?cname(r.value.med):''}${(r.value.zv||[]).length?' <span class="pill" style="background:#fde68a;color:#92400e">'+r.value.zv.join('·')+'</span>':''}${!r.value.med&&!(r.value.zv||[]).length?'–':''}</td><td>${(r.value.nodes||[]).length}N ${(r.value.edges||[]).length}E</td><td><span class="pill ${LIN(r.value.lineage)}">${r.value.lineage||'–'}</span></td><td style="color:#94a3b8">${new Date(r.ts).toLocaleTimeString('ko-KR')}</td></tr>`).join('')+`</table>`:`<div class="empty">아직 제출이 없습니다. 캔버스에서 제출하면 바로 여기 뜹니다.</div>`;
  rows.forEach(r=>seen.add(r.ts));document.querySelectorAll('.tbl tr[data-i]').forEach(tr=>tr.onclick=()=>spot(rows[+tr.dataset.i]));}
function spot(r){const v=r.value,ns=v.nodes||[],mnx=Math.min(...ns.map(n=>n.x),0),mny=Math.min(...ns.map(n=>n.y),0);const pos={};
  const verdicts=LS('w11_control').filter(c=>c.key==='verdict'&&c.value&&c.value.dev===r.dev),cur=verdicts.length?verdicts[verdicts.length-1].value.text:'';
  $('mbox').innerHTML=`<div class="mh"><h2>${esc(r.nickShown||r.nick||'–')}의 연구모형</h2><span class="pill ${LIN(v.lineage)}">${esc(v.lineage||'')}</span><button class="x" id="mx">×</button></div>
  <div style="display:flex;gap:6px;align-items:center;margin-bottom:10px;font-size:12px"><span style="color:#64748b;font-weight:700">교수님 판정</span>${['개념과 측정이 맞다','개념과 측정이 어긋난다','인과 방향을 다시 보자','좋은 빈자리다'].map(t=>`<button class="rbtn ${cur===t?'dark':''}" data-v="${t}">${t}</button>`).join('')}<span style="color:#94a3b8;font-size:11px">학생 화면에 바로 뜹니다</span></div>
  <div class="diag" id="diag">${ns.map(n=>`<div class="nd ${n.role}" data-id="${n.id}" style="left:${n.x-mnx+10}px;top:${n.y-mny+10}px"><small>${n.role}</small>${esc(n.name)}<small style="letter-spacing:0;font-weight:400">${n.items.length}문항</small></div>`).join('')}<svg style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none"><defs><marker id="m" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#e53e3e"/></marker></defs><g id="dg"></g></svg></div>
