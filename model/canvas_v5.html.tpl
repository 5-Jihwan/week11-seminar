function nodeAt(cx,cy){return st.nodes.find(n=>{const el=document.querySelector(`.node[data-id="${n.id}"]`);if(!el)return false;const b=el.getBoundingClientRect();return cx>=b.left&&cx<=b.right&&cy>=b.top&&cy<=b.bottom;});}
