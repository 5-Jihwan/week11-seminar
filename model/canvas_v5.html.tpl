const THEME_KO={TR:"신뢰",NW:"참여·연결망·호혜",IN:"제도·정책 경험",FA:"공정성",RG:"지역",DM:"개인 특성",ET:"기타"};
const COMP_OF={full_TR:"generalized_trust",full_NW:"network",trust_general:"generalized_trust",trust_social:"generalized_trust",trust_neighbor:"neighbor_trust",trust_institution:"institutional_trust",participation:"participation",volunteer_donate:"volunteer_donate",network_reciprocity:"reciprocity",political_participation:"political_participation"};
const COMP_KO={generalized_trust:"일반신뢰",institutional_trust:"기관신뢰",neighbor_trust:"이웃 신뢰",participation:"단체 참여",volunteer_donate:"봉사·기부",network:"연결망",reciprocity:"호혜",political_participation:"정치 참여"};
