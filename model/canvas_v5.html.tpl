  const q=st.search.trim().toLowerCase(),its=IT.map((i,k)=>({i,k})).filter(x=>x.i.survey===st.survey&&okItem(x.i)&&(st.full||q||!x.i.full)&&(!q||(x.i.question+' '+cname(x.i.concept)+' '+(x.i.var||'')).toLowerCase().includes(q))),used=new Set(st.nodes.flatMap(n=>n.items)),nFull=IT.filter(i=>i.survey===st.survey&&i.full).length;$('pfull').style.display=nFull?'':'none';$('pfull').textContent=`전체 ${nFull}`;$('pfull').classList.toggle('on',st.full);
  el.innerHTML=`<div class="hintbox"><span class="ms" style="font-size:12px;vertical-align:middle;margin-right:4px">touch_app</span>${st.full||q?`조사표 ${st.full?"전체":"검색 결과"}입니다. 어느 문항이든 끌어다 묶을 수 있습니다.`:`선행연구에서 흔히 쓰는 문항입니다. 조사표 전체는 「전체」나 검색으로 엽니다.${nFull?"":" (이 조사는 요약 문항만 있습니다. 전체 조사표는 기관 누리집에서.)"}`}</div>`+["TR","NW","IN","FA","RG","DM","ET"].map(t=>{const g=its.filter(x=>THEME(x.i.concept)===t);return g.length?`<div class="eyebrow">${THEME_KO[t]} · ${g.length}</div>`+g.map(x=>`<div class="vcard ${used.has(x.k)?'used':''}" data-k="${x.k}"><div class="vbadge ${t}">${t}</div><div class="vname">${x.i.question}<span class="vtag">${cname(x.i.concept)} · ${x.i.wave||''} · ${x.i.scale||''}${x.i.unit?' · '+x.i.unit:''}</span></div>${used.has(x.k)?'':`<button class="addk" data-add="${x.k}" title="끌지 않고 추가" style="border:0;background:var(--ink-100);border-radius:6px;width:24px;height:24px;flex-shrink:0;color:var(--ink-500);font-weight:700">+</button>`}</div>`).join(''):''}).join('')+`<div style="font-size:9.5px;color:var(--ink-300);text-align:center;margin-top:12px;font-family:var(--font-mono)">${its.length}개 문항 · ${used.size}개 배치됨 · 끌기가 안 되면 + 버튼</div>`;
  el.onclick=e=>{const b=e.target.closest('[data-add]');if(!b)return;e.stopPropagation();const k=+b.dataset.add,r=$('cv').getBoundingClientRect(),d=dvNode();  /* + 버튼: 역할을 고르면 새 변수, 종속변수가 있으면 거기 묶는 선택지도 */
    const p=$('pop');rolePop(r.left+r.width/2-120,r.top+80,IT[k],role=>newNode(k,role,{x:r.width*({DV:.78,IV:.06,MV:.4,ZV:.4,CV:.06})[role],y:r.height*(role==="ZV"?.06:role==="CV"?.78:.3)+st.nodes.filter(n=>n.role===role).length*74}));
    if(d){const b2=document.createElement('button');b2.innerHTML=`<span class="c">＋</span><span><b style="font-size:11.5px">${esc(d.name)}에 묶기</b></span>`;b2.style.cssText='border-color:#c084fc;background:#f3e8ff;color:#6d28d9';b2.onclick=ev=>{ev.stopPropagation();p.classList.remove('on');d.items.push(k);touch();openDrawer('justify',d.id);};p.insertBefore(b2,p.querySelector('button'));}};}
