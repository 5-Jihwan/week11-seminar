/* 전체 스크리닝: 220편 전부에 점수와 근거를 매긴다. 점수 = 구성 요소 자카드×3 + 단위 1 + 원인 축 1.5 + 매개 1 + 차원 1 (최대 7.5). 등급: 닮음 ≥4.5 · 부분 2.5~4.5 · 다름 >0 · 무관 0 */
function screen(){const cs=dvComps();if(!cs.length)return[];const dim=dvDim(),srcs=ivSrcs(),med=!!st.nodes.find(n=>n.role==="MV"),myUnit=srcs.includes('context')&&st.survey==='chs'?'region':'individual';
  return STUDIES.filter(s=>DEMO||s.ok).map(s=>{const inter=s.comps.filter(c=>cs.includes(c)),uni=[...new Set([...s.comps,...cs])],why=[];let sc=3*inter.length/uni.length;if(inter.length)why.push(`구성 요소 ${inter.length}/${uni.length} 겹침`);
    if(s.unit===myUnit||s.unit==='mixed'){sc+=1;why.push('같은 단위');}if(ssrc(s).some(x=>srcs.includes(x))){sc+=1.5;why.push('같은 원인 축');}if(med&&s.med){sc+=1;why.push('매개 있음');}if(sdim(s)===dim){sc+=1;why.push('같은 차원');}
    if(s.data&&SDATA[st.survey]&&s.data.includes(SDATA[st.survey])){sc+=2;why.push('같은 자료');}if(s.kr){sc+=.5;why.push('국내');}if(s.dv){sc+=1;why.push('사회자본이 종속');}const tier=!inter.length?'무관':sc>=6?'닮음':sc>=3.5?'부분':'다름';return {s,sc:inter.length?sc:0,tier,why,inter,only:s.comps.filter(c=>!cs.includes(c)),miss:cs.filter(c=>!s.comps.includes(c))};}).sort((a,b)=>b.sc-a.sc);}
function match(){const a=screen().filter(x=>x.inter.length);return [...a.filter(x=>x.s.kr).slice(0,5),...a.filter(x=>!x.s.kr).slice(0,5)];}
function topFor(cs){const m=STUDIES.filter(s=>DEMO||s.ok).map(s=>{const inter=s.comps.filter(c=>cs.includes(c)),uni=[...new Set([...s.comps,...cs])];return {s,sc:3*inter.length/uni.length+(s.unit==='individual'||s.unit==='mixed'?1:0),inter};}).filter(x=>x.inter.length).sort((a,b)=>b.sc-a.sc)[0];return m?`${m.s.au} (${m.s.y})`:'없음';}
function altDefs(){const d=dvNode();if(!d||!d.items.length)return[];const out=[],cs=comps(d),now=topFor(cs),compsOf=ks=>[...new Set(ks.map(k=>COMP_OF[IT[k].concept]).filter(Boolean))];
  if(d.items.length>1){const k=d.items[d.items.length-1],c2=compsOf(d.items.filter(x=>x!==k));out.push({t:`「${IT[k].question.slice(0,28)}…」을 빼면`,d:`구성 요소 ${c2.map(c=>COMP_KO[c]).join('·')||'—'} → 닮은 연구 1위 ${topFor(c2)}${topFor(c2)===now?' (그대로)':''}`});}
