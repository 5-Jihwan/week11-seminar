  if(dOpen==='studies'){const all=screen(),m=all.filter(x=>x.inter.length).slice(0,5),ce=cell(),cnt=t=>all.filter(x=>x.tier===t).length,others=peers(),gapN=ce&&ce.n<15?ce.n:null;
    el.innerHTML=(ce?`<div class="def"><b>${ce.label}</b><small>같은 칸의 1부 논문: ${ce.papers.join(', ')||'없음'} · 선행연구 ${ce.n}편</small></div>`:`<div class="hintbox">${esc(whyNoSim()||(st.nodes.some(n=>n.role==="IV")?'독립변수 문항의 원인 축을 알 수 없습니다.':'독립변수(IV)를 하나 두면 분류 틀의 어느 칸인지 보여 드립니다.'))}</div>`)+
    (gapN!==null?`<div class="hyp" style="background:linear-gradient(135deg,#fffbeb,#fef3c7);border-color:#fcd34d;color:#92400e"><div class="e" style="color:#b45309">빈자리</div>이 칸의 선행연구는 ${gapN}편뿐입니다.${others.sameCell===0?' 오늘 이 칸을 고른 사람은 당신이 처음입니다.':` 오늘 이 칸을 고른 사람은 당신 포함 ${others.sameCell+1}명입니다.`} 선행연구가 없는 이유가 자료가 없어서인지, 아무도 안 물어서인지가 연구질문이 됩니다.</div>`:'')+
    `<div class="eyebrow">분류 틀 · 원인 축(Hooghe & Stolle) × 종속 차원(Uphoff)</div>`+cellTable(ce)+
    (m.length?`<div class="eyebrow">닮은 국내 연구 · ${m.filter(x=>x.s.kr).length} ${DEMO?'<span style="font-weight:400;text-transform:none;letter-spacing:0">(규칙 코딩 · 미검수)</span>':''}</div>`+(m.filter(x=>x.s.kr).map(studyCard).join('')||'<div class="hintbox">같은 구성 요소를 잰 국내 연구가 없습니다.</div>')+`<div class="eyebrow">닮은 해외 연구 · ${m.filter(x=>!x.s.kr).length}</div>`+m.filter(x=>!x.s.kr).map(studyCard).join(''):'')+
    (all.length?`<div class="eyebrow">전체 스크리닝 · ${all.length}편</div><div class="row" id="tiers">${[['닮음','#0f766e'],['부분','#1d4ed8'],['다름','#b45309'],['무관','#64748b']].map(([t,c])=>`<button data-t="${t}" class="${t==='닮음'?'on':''}" style="${t==='닮음'?'':'color:'+c}">${t} ${cnt(t)}</button>`).join('')}</div><div id="tierlist"></div>`:'')+
    (others.defs.length?`<div class="eyebrow">같은 자료를 고른 옆 사람 · ${others.defs.length}</div>`+others.defs.map(d=>`<div class="alt"><b>${esc(d.nick)}</b>${esc(d.def)}</div>`).join('')+`<div style="font-size:11.5px;color:var(--ink-500);line-height:1.6">같은 조사, 다른 정의입니다. 이 차이가 조작적 정의입니다.</div>`:'')+
    `<div class="eyebrow">연구질문 한 줄</div><input class="inp" id="q" value="${st.q.replace(/"/g,'&quot;')}" placeholder="~는 ~와 관련이 있는가"><div style="margin-top:10px"><button class="primary" id="sub2" ${$('submit').disabled?'disabled':''}>제출하고 대시보드에 올리기</button></div>`;
    const tierList=t=>{const L=all.filter(x=>x.tier===t);$('tierlist').innerHTML=L.length?`<div style="max-height:320px;overflow-y:auto;border:1px solid var(--ink-100);border-radius:var(--r-md)">`+L.map(x=>`<div class="item" style="padding:6px 8px"><div style="flex:1;min-width:0"><div style="font-size:11.5px;font-weight:600;line-height:1.35">${esc(x.s.t)}</div><div class="k">${esc(x.s.au)} (${x.s.y}) · <b>${Math.round(x.sc/MAXSC*100)}%</b> 유사 · ${x.why.join(' · ')||'겹치는 구성 요소 없음'} · ${x.s.comps.map(c=>COMP_KO[c]).join('·')}</div></div>${x.s.link?`<a href="${x.s.link}" target="_blank" rel="noopener" style="font-size:11px;align-self:center">원문</a>`:''}</div>`).join('')+`</div>`:`<div class="hintbox">없음</div>`;};
    if(all.length){tierList('닮음');$('tiers').onclick=e=>{const b=e.target.closest('button');if(!b)return;[...$('tiers').children].forEach(x=>x.classList.toggle('on',x===b));tierList(b.dataset.t);};}
    $('q').oninput=e=>{st.q=e.target.value;persist();};$('sub2').onclick=submit;el.onclick=null;return;}
  if(dOpen==='review'){const rv=review();el.innerHTML=rv.length?rv.map(([k,t])=>`<div class="v2card"><div class="eyebrow" style="margin:0 0 4px">${k}</div><div style="font-size:12.5px;line-height:1.7;color:var(--ink-700)">${B(t)}</div></div>`).join(''):`<div class="hintbox">종속변수와 자료가 정해지면 약한 고리와 한 단계를 보여 드립니다.</div>`;el.onclick=null;}}
/* ── 제출 ── */
function finalHyps(){return hyps().map((h,i)=>st.hypEdits[i]||h);}
function modelValue(){const d=dvNode(),ce=cell(),SC=screen();return {survey:st.survey,concept:st.concept,dv:dvConcept(),dv_name:d?d.name:'',definition:defLine(),comps:dvComps(),dim:dvDim(),srcs:ivSrcs(),iv:ivConcepts(),med:medConcept(),zv:st.nodes.filter(n=>n.role==="ZV").map(n=>n.name),cv:st.nodes.filter(n=>n.role==="CV").map(n=>n.name),gap_ok:!gap().some(i=>i.l==='warn'),
    nodes:st.nodes.map(n=>({id:n.id,name:n.name,role:n.role,items:n.items,x:n.x,y:n.y})),edges:st.edges,q:st.q,lineage:ce?ce.label:'미분류',lineage_t:ce?('같은 칸: '+(ce.papers.join(', ')||'없음')):'',matches:(()=>{const a=SC.filter(x=>x.inter.length);return [...a.filter(x=>x.s.kr).slice(0,5),...a.filter(x=>!x.s.kr).slice(0,5)];})().map(x=>({id:x.s.id,au:x.s.au,y:x.s.y,t:x.s.t,sc:+x.sc.toFixed(2),pct:Math.round(x.sc/MAXSC*100),why:x.why})),tiers:(()=>{const o={};SC.forEach(x=>o[x.tier]=(o[x.tier]||0)+1);return o;})(),hyps:finalHyps()};}
function submit(){if($('submit').disabled)return;const row={ts:new Date().toISOString(),dev:DEV,nick:$('nick').value.trim()||('익명'+Math.floor(Math.random()*900+100)),stage:'model',key:'submit',tok:TOK,value:modelValue()};
  const a=LS('w11_model')||[];a.push(row);LS('w11_model',a);if(SAVE_URL)fetch(SAVE_URL+'/submit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(row)}).catch(()=>{});
  toast(`"${row.nick}" 제출 완료 ☁ 대시보드에 올라갔습니다`);$('submit').disabled=true;$('submit').innerHTML='<span class="ms" style="font-size:13px">check</span>제출됨 · 다시 내면 최신 것만 셉니다';setTimeout(()=>{$('submit').disabled=!(st.nodes.length&&!validate().some(i=>i.l==='err'));},4000);}
$('submit').onclick=submit;$('nick').oninput=persist;
if(restore()){renderPanel();draw();toast('이어서 작업합니다. 처음부터 하려면 「비우기」');}else{gate();renderPanel();draw();}loadPeers();pollVerdict();
</script></div></body></html>
