$('rhandle').addEventListener('pointerdown',e=>{if(e.target.closest('.ptog')||$('lpanel').classList.contains('collapsed'))return;rs={x:e.clientX,w:$('lpanel').offsetWidth};$('rhandle').classList.add('on');document.body.style.cursor='col-resize';});
