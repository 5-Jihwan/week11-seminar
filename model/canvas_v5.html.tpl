<style>
/* ── Galpi Design System v2 토큰 (frontend/src/index.css) ── */
:root{--brand-navy-900:#011a35;--brand-navy-800:#022448;--brand-navy-700:#1e3a5f;--brand-navy-400:#8aa4cf;--brand-navy-300:#adc8f5;--brand-navy-200:#d5e3ff;--brand-navy-100:#e8edf7;--brand-navy-50:#f0f4ff;
--brand-teal-700:#006a61;--brand-teal-500:#6bd8cb;--brand-teal-300:#b4f5ec;--brand-teal-200:#99f6e4;--brand-teal-50:#f0fdf8;
--paper:#fafaf7;--paper-2:#f3f3ee;--ink-900:#0d1117;--ink-800:#1a2030;--ink-700:#2c313a;--ink-600:#434a56;--ink-500:#5c626d;--ink-400:#8b919c;--ink-300:#b9bdc6;--ink-200:#d8dbe1;--ink-150:#e4e7ec;--ink-100:#ebedf0;--ink-50:#fafafa;
--ok:#15803d;--ok-soft:#dcfce7;--warn:#b45309;--warn-soft:#fef3c7;--danger:#b91c1c;--danger-soft:#fee2e2;
--font-sans:"Pretendard","Inter",-apple-system,"Apple SD Gothic Neo",sans-serif;--font-mono:"JetBrains Mono","SF Mono",Menlo,monospace;
--r-sm:4px;--r-md:8px;--r-lg:14px;--r-xl:20px;--shadow-1:0 1px 2px rgba(13,17,23,.04),0 1px 1px rgba(13,17,23,.03);--shadow-2:0 4px 12px rgba(13,17,23,.06),0 1px 2px rgba(13,17,23,.04);--shadow-3:0 16px 40px rgba(13,17,23,.10),0 2px 6px rgba(13,17,23,.05);
--canvas-dot:radial-gradient(circle at 2px 2px,rgba(60,64,75,.18) 1px,transparent 0)}
*,*::before,*::after{box-sizing:border-box}html,body{margin:0;height:100%}body{font-family:var(--font-sans);color:var(--ink-900);background:var(--paper);-webkit-font-smoothing:antialiased;overscroll-behavior:none}
button{font-family:inherit;cursor:pointer}.ms{font-family:'Material Symbols Outlined';font-weight:normal;font-style:normal;font-size:18px;line-height:1;display:inline-block;vertical-align:middle;font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 20;user-select:none}
.app{display:flex;flex-direction:column;height:100dvh;overflow:hidden}
/* 헤더 */
.v2-header{height:52px;display:flex;align-items:center;padding:0 16px;gap:8px;background:rgba(250,250,247,.92);backdrop-filter:blur(12px);border-bottom:1px solid rgba(0,0,0,.06);flex-shrink:0;z-index:50}
.v2-brand{display:flex;align-items:center;gap:8px;font-weight:700;font-size:14px;letter-spacing:-.02em;color:var(--brand-navy-800)}.v2-brand .dot{width:20px;height:20px;border-radius:6px;background:linear-gradient(135deg,var(--brand-navy-800),var(--brand-teal-700))}
.spacer{flex:1}.chip{display:inline-flex;align-items:center;gap:5px;height:26px;padding:0 10px;border-radius:999px;font-size:11px;font-weight:600;font-family:var(--font-mono);background:#fff;border:1px solid rgba(0,0,0,.07);color:var(--ink-700);box-shadow:var(--shadow-1);white-space:nowrap}
.lvl{padding:3px 10px;border-radius:999px;font-size:10.5px;font-weight:700;letter-spacing:.04em;background:var(--brand-teal-50);color:var(--brand-teal-700);border:1px solid var(--brand-teal-200)}
.nick{height:30px;border:1px solid var(--ink-200);border-radius:999px;padding:0 12px;font:inherit;font-size:12px;width:110px;background:#fff}
.share{height:30px;padding:0 14px;border-radius:999px;border:0;background:var(--brand-navy-800);color:#fff;font-size:12px;font-weight:700;display:inline-flex;align-items:center;gap:5px}.share:hover{filter:brightness(1.1)}.share:disabled{opacity:.45;cursor:default}
/* 본문 */
.body{display:flex;flex:1;min-height:0;overflow:hidden;position:relative}
.lpanel{background:#fff;border-right:1px solid rgba(0,0,0,.07);display:flex;flex-direction:column;min-height:0;flex-shrink:0;position:relative}
.ptabs{display:flex;padding:8px 12px 0;gap:2px;border-bottom:1px solid var(--ink-100);flex-shrink:0}.ptab{height:34px;padding:0 10px;border:0;background:transparent;color:var(--ink-500);font-size:12px;font-weight:500;border-bottom:2px solid transparent;display:inline-flex;align-items:center;gap:5px}.ptab.active{color:var(--brand-navy-800);font-weight:600;border-bottom-color:var(--brand-navy-800)}
.psbar{display:flex;gap:6px;padding:8px 12px 0}.psbar input{flex:1;height:30px;border:1px solid var(--ink-200);border-radius:999px;padding:0 12px;font:inherit;font-size:12px}.psbar button{height:30px;padding:0 12px;border-radius:999px;border:1px solid var(--ink-200);background:#fff;font-size:11.5px;font-weight:700;color:var(--ink-600)}.psbar button.on{background:var(--brand-navy-800);color:#fff;border-color:var(--brand-navy-800)}
.pcontent{flex:1;overflow-y:auto;padding:14px 12px 30px}.pcontent::-webkit-scrollbar{width:6px}.pcontent::-webkit-scrollbar-thumb{background:var(--ink-200);border-radius:6px}
.eyebrow{font-size:9.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-400);font-family:var(--font-mono);margin:12px 0 7px}
.hintbox{margin:0 0 10px;padding:7px 9px;background:var(--brand-navy-50);border:1px solid var(--brand-navy-200);border-radius:7px;font-size:10.5px;color:var(--brand-navy-700);line-height:1.5}
.vcard{display:flex;align-items:flex-start;gap:9px;padding:8px 10px;border-radius:var(--r-md);border:1px solid var(--ink-100);background:#fff;cursor:grab;transition:all .12s;margin-bottom:5px;user-select:none;touch-action:none}
.vcard:hover{border-color:var(--brand-navy-300);background:var(--brand-navy-50);transform:translateX(2px)}.vcard.used{opacity:.45;cursor:default}.vcard.used:hover{transform:none}
.vbadge{width:28px;height:28px;border-radius:var(--r-sm);background:var(--ink-100);display:grid;place-items:center;font-size:9.5px;font-weight:800;font-family:var(--font-mono);flex-shrink:0;color:var(--ink-500)}
.vbadge.iv{background:var(--brand-navy-200);color:var(--brand-navy-800)}.vbadge.mv{background:var(--brand-teal-300);color:var(--brand-teal-700)}.vbadge.dv{background:#ede9fe;color:#6d28d9}
.vname{font-size:12px;font-weight:500;color:var(--ink-900);line-height:1.35;min-width:0}.vtag{font-size:9.5px;font-family:var(--font-mono);color:var(--ink-400);margin-top:2px;display:block}
.surv{border:1.5px solid var(--ink-100);border-radius:var(--r-lg);padding:11px 12px;margin-bottom:8px;cursor:pointer;background:#fff;transition:all .12s}.surv:hover{border-color:var(--brand-navy-300);box-shadow:var(--shadow-2)}.surv.on{border-color:var(--brand-navy-800);background:var(--brand-navy-50)}
.surv b{display:block;font-size:13px;color:var(--brand-navy-800)}.surv small{display:block;font-size:10.5px;color:var(--ink-500);margin-top:2px;line-height:1.45}
.ptog{position:absolute;top:50%;left:-1px;transform:translateY(-50%);width:18px;height:48px;border:1px solid var(--ink-200);border-left:0;background:#fff;border-radius:0 8px 8px 0;font-size:14px;color:var(--ink-500);cursor:pointer;z-index:6;padding:0;box-shadow:var(--shadow-1)}.ptog:hover{color:var(--brand-navy-800)}.lpanel.collapsed{width:0!important;min-width:0;overflow:hidden;border-right:0}.lpanel.collapsed+.rhandle{cursor:default}
.rhandle{position:relative;width:6px;cursor:col-resize;flex-shrink:0;background:transparent;display:grid;place-items:center;transition:background .15s}.rhandle:hover,.rhandle.on{background:rgba(30,64,175,.15)}.rhandle i{width:2px;height:28px;border-radius:2px;background:var(--ink-300)}
/* 캔버스 */
.cvwrap{flex:1;display:flex;min-width:0;min-height:0}.cv{flex:1;position:relative;min-width:0;background:var(--paper);background-image:var(--canvas-dot);background-size:28px 28px;overflow:hidden;touch-action:none}
.toolbar{position:absolute;top:14px;left:14px;z-index:10;display:flex;gap:2px;padding:4px;background:rgba(255,255,255,.92);backdrop-filter:blur(8px);border:1px solid rgba(0,0,0,.07);border-radius:var(--r-lg);box-shadow:var(--shadow-2)}
.tool{height:32px;padding:0 10px;border:0;background:transparent;border-radius:var(--r-md);color:var(--ink-500);display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;white-space:nowrap}.toolbar{flex-wrap:nowrap;max-width:calc(100% - 28px)}.tool:hover{background:var(--ink-100);color:var(--ink-900)}.tool.active{background:var(--brand-navy-800);color:#fff}
.zone{position:absolute;border:1px dashed;border-radius:12px;display:flex;justify-content:center;padding-top:6px;pointer-events:none;z-index:0;font-size:8.5px;font-weight:700;font-family:var(--font-mono);letter-spacing:.08em;opacity:.75}
.cv.zvsel .edge[data-eid]{pointer-events:visibleStroke;stroke-width:6;cursor:pointer;animation:none;stroke-dasharray:none;opacity:.8}.hd{fill:#f59e0b;stroke:#fff;stroke-width:3;pointer-events:all;cursor:pointer;animation:hd 1.2s ease-in-out infinite}@keyframes hd{50%{r:14}}.cv.zvsel .edge[data-eid]:hover{stroke:#f59e0b}
.donut{display:inline-grid;place-items:center;width:44px;height:44px;flex-shrink:0}.donut svg{grid-area:1/1}.donut b{grid-area:1/1;font-size:11px;font-family:var(--font-mono);color:var(--brand-navy-800)}.pct{display:flex;align-items:center;gap:8px}.pct .w{font-size:11px;color:var(--ink-500);line-height:1.45}
.empty{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:#a0aec0;pointer-events:none;text-align:center;padding:20px}.empty .ms{font-size:48px;color:#d1d5db}.empty p{margin:0;font-size:15px}.empty small{font-size:12px;line-height:1.7}
svg.edges{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:1}.edge{stroke:#e53e3e;stroke-width:2;fill:none;stroke-dasharray:6 4;animation:dash 1s linear infinite}.edge.bad{stroke:#f59e0b}@keyframes dash{to{stroke-dashoffset:-20}}
.node{position:absolute;z-index:2;min-width:118px;max-width:170px;padding:8px 14px;text-align:center;border-radius:10px;border:1.5px solid;box-shadow:0 1px 3px rgba(0,0,0,.06);transition:box-shadow .15s,border .15s;user-select:none;cursor:grab;touch-action:none}
.node.IV{background:linear-gradient(160deg,#fff 0%,#d5e3ff 100%);border-color:#adc8f5;color:#1e3a5f}.node.MV{background:linear-gradient(160deg,#fff 0%,#b4f5ec 100%);border-color:#6bd8cb;color:#006a61}.node.DV{background:linear-gradient(160deg,#fff 0%,#e9d5ff 100%);border-color:#c084fc;color:#6d28d9}.node.CV{background:linear-gradient(160deg,#fff 0%,#e5e7eb 100%);border-color:#d1d5db;color:#374151}
.node:hover{box-shadow:0 3px 12px rgba(0,0,0,.12)}.node.src{border-width:2.5px;animation:pulse 1.5s ease-in-out infinite;cursor:crosshair}.node.over{border-width:2.5px;box-shadow:0 0 0 3px #10b98155,0 0 14px #10b98133;border-color:#10b981}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(29,58,95,.5)}70%{box-shadow:0 0 0 8px rgba(29,58,95,0)}100%{box-shadow:0 0 0 0 rgba(29,58,95,0)}}
.node .r{font-size:8.5px;font-weight:800;letter-spacing:.1em;opacity:.6;font-family:var(--font-mono);margin-bottom:3px}.node .l{font-size:12px;font-weight:700;line-height:1.3;word-break:keep-all}.node .v{font-size:9px;opacity:.5;font-family:var(--font-mono);margin-top:3px}
.node .del{position:absolute;top:-9px;right:-9px;width:18px;height:18px;border-radius:50%;border:0;background:#ef4444;color:#fff;font-size:10px;font-weight:700;display:none;place-items:center;box-shadow:0 1px 4px rgba(0,0,0,.25)}.node:hover .del{display:grid}
.node .tip{position:absolute;bottom:-22px;left:50%;transform:translateX(-50%);font-size:9px;font-weight:700;padding:1px 6px;border-radius:4px;white-space:nowrap;pointer-events:none;background:#fff;border:1px solid currentColor}
.cbar{position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:50;background:#1e3a5f;color:#fff;padding:6px 16px;border-radius:8px;font-size:11.5px;font-weight:700;display:flex;align-items:center;gap:8px;box-shadow:0 4px 16px rgba(0,0,0,.18);pointer-events:none}
.status{position:absolute;bottom:14px;left:14px;display:flex;gap:6px;z-index:10}.schip{display:inline-flex;align-items:center;gap:5px;height:24px;padding:0 10px;border-radius:999px;font-size:11px;font-weight:600;font-family:var(--font-mono);background:rgba(255,255,255,.92);border:1px solid rgba(0,0,0,.07);color:var(--ink-700);box-shadow:var(--shadow-1)}
.fbtns{position:absolute;bottom:16px;right:16px;z-index:50;display:flex;gap:8px;align-items:center}.fbtns .vbtn{position:static}.sbtn2{border-color:var(--brand-navy-700)!important;color:var(--brand-navy-800)!important}.spanel{z-index:69}.sp{display:flex;gap:8px;align-items:center;padding:7px 0;border-bottom:1px solid #f1f5f9}.sp .t2{font-size:12px;font-weight:700;line-height:1.35;color:#0f172a}.sp .a2{font-size:10.5px;color:#64748b;font-family:var(--font-mono)}
.vbtn{position:absolute;bottom:16px;right:16px;z-index:50;display:flex;align-items:center;gap:7px;padding:7px 14px;border-radius:999px;background:#fff;border:2px solid var(--ok);color:var(--ok);box-shadow:0 4px 16px rgba(0,0,0,.12);font-size:12px;font-weight:700}.vbtn.warn{border-color:#d97706;color:#d97706}.vbtn.err{border-color:#e11d48;color:#e11d48}
.vpanel{position:absolute;bottom:60px;right:16px;z-index:70;width:340px;max-height:70vh;background:#fff;border-radius:14px;box-shadow:0 8px 40px rgba(2,36,72,.18);border:1px solid #e2e8f0;display:none;flex-direction:column;overflow:hidden}.vpanel.on{display:flex}
.vhead{padding:13px 16px 11px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between}.vhead .t{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;margin-bottom:2px}.vhead .s{font-size:12px;color:#64748b}
.vbody{flex:1;overflow-y:auto;padding:8px 14px 14px}.sum{display:flex;gap:6px;padding:10px 16px 4px}.pill{display:flex;align-items:center;gap:4px;padding:3px 9px;border-radius:99px;font-size:11px;font-weight:700}
.iss{border:1px solid;border-left:3px solid;border-radius:8px;background:#fff;margin-bottom:6px;padding:9px 12px}.iss .m{font-size:12.5px;font-weight:700;color:#0f172a;line-height:1.4}.iss .d{font-size:12px;color:#334155;line-height:1.65;margin-top:5px}
.iss.err{border-color:#e11d4822;border-left-color:#e11d48}.iss.warn{border-color:#d9770622;border-left-color:#d97706}.iss.info{border-color:#0891b222;border-left-color:#0891b2}.iss.ok{border-color:#16a34a22;border-left-color:#16a34a}
.sug{margin-top:6px;padding:6px 10px;border-radius:6px;background:#f0f4ff;font-size:11.5px;color:#3730a3;line-height:1.5}
/* 우측 드로어 */
.drawer{display:flex;flex-shrink:0;z-index:60;min-height:0}.dpanel{width:0;overflow:hidden;transition:width .22s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;background:#fff;border-left:1px solid var(--ink-150);position:relative}.dpanel.on{box-shadow:-4px 0 20px rgba(0,0,0,.08)}.dpanel.drag{transition:none}
.dhandle{position:absolute;left:0;top:0;bottom:0;width:6px;cursor:col-resize;z-index:20}.dhandle:hover,.dhandle.on{background:rgba(30,64,175,.18)}
.dhead{padding:12px 14px 10px 18px;border-bottom:1px solid var(--ink-100);display:flex;align-items:center;gap:8px;flex-shrink:0}.dhead .t{flex:1;font-size:12px;font-weight:700;color:var(--ink-900)}.dhead .px{font-size:9.5px;color:var(--ink-300);font-family:var(--font-mono)}.dhead .x{width:24px;height:24px;border:0;background:transparent;border-radius:6px;color:var(--ink-400)}
.dbody{flex:1;overflow-y:auto;padding:14px 14px 24px;min-width:260px}
.strip{width:52px;flex-shrink:0;display:flex;flex-direction:column;align-items:center;padding-top:14px;gap:6px;background:var(--paper-2);border-left:1px solid var(--ink-100);pointer-events:auto}
.sbtn{width:42px;height:42px;border:0;border-radius:10px;background:transparent;color:var(--ink-500);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;transition:all .12s}.sbtn:hover{background:var(--ink-100);color:var(--ink-800)}.sbtn.on{background:var(--brand-navy-800);color:#fff}.sbtn span.l{font-size:8px;font-weight:700;font-family:var(--font-mono);line-height:1}
.v2card{background:#fff;border-radius:var(--r-lg);border:1px solid var(--ink-100);box-shadow:var(--shadow-1);padding:10px 12px;margin-bottom:10px}.v2card .h{font-size:16px;font-weight:800;color:var(--ink-900);margin-bottom:6px}
.rb{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:700}.rb.IV{background:#d5e3ff;color:#1e3a5f}.rb.MV{background:#b4f5ec;color:#006a61}.rb.DV{background:#e9d5ff;color:#6d28d9}.rb.CV{background:#e5e7eb;color:#374151}
.theory{padding:5px 10px;border-radius:7px;font-size:11px;background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;line-height:1.5;margin-bottom:5px}
.caution{padding:9px 12px;border-radius:8px;font-size:11.5px;line-height:1.6;background:#fff7ed;border:1px solid #fed7aa;color:#c2410c;margin:8px 0}
.hyp{padding:10px 12px;border-radius:8px;font-size:12px;line-height:1.7;background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:1px solid #86efac;color:#166534;margin-bottom:6px}.hyp .e{font-size:9.5px;font-weight:700;letter-spacing:.08em;color:#16a34a;margin-bottom:4px}
.study{border:1px solid var(--ink-100);border-radius:var(--r-lg);padding:10px 12px;margin-bottom:8px;background:#fff}.study .ti{font-size:12.5px;font-weight:700;color:var(--ink-900);line-height:1.4}.study .au{font-size:10.5px;font-family:var(--font-mono);color:var(--ink-400);margin-bottom:4px}.study .ln{font-size:11.5px;color:var(--ink-700);line-height:1.55;margin-top:4px}.study .sim{font-size:11px;margin-top:5px;display:flex;gap:4px;flex-wrap:wrap}.study .sim i{font-style:normal;padding:1px 7px;border-radius:99px;background:var(--brand-teal-50);color:var(--brand-teal-700);border:1px solid var(--brand-teal-200)}.study .sim i.d{background:#fff7ed;color:#c2410c;border-color:#fed7aa}.study .sim i.m{background:var(--brand-navy-50);color:var(--brand-navy-700);border-color:var(--brand-navy-200)}.study a{font-size:11px;color:var(--brand-navy-700)}
.pct{margin:5px 0 2px}
.def{padding:10px 12px;border-radius:var(--r-lg);background:var(--brand-navy-50);border:1px solid var(--brand-navy-200);font-size:12.5px;line-height:1.6;color:var(--brand-navy-800);margin-bottom:10px}.def small{display:block;color:var(--ink-500);font-size:11px;margin-top:4px}
.alt{padding:9px 12px;border-radius:8px;border:1px dashed var(--ink-200);font-size:12px;margin-bottom:6px;line-height:1.55}.alt b{display:block;color:var(--ink-900);margin-bottom:2px}
.item{display:flex;gap:8px;align-items:flex-start;border-bottom:1px solid var(--ink-100);padding:7px 0;font-size:12px}.item .x{border:0;background:none;color:var(--ink-400);font-size:14px}.item .k{font-size:10.5px;color:var(--ink-400);font-family:var(--font-mono)}
.inp{width:100%;font:inherit;font-size:13px;padding:8px 10px;border:1.5px solid var(--brand-navy-300);border-radius:var(--r-md);outline:none}.row{display:flex;gap:6px;flex-wrap:wrap;margin:6px 0}.row button{height:28px;padding:0 10px;border-radius:999px;border:1px solid var(--ink-200);background:#fff;font-size:11.5px;font-weight:700;color:var(--ink-600)}.row button.on{background:var(--brand-navy-800);color:#fff;border-color:var(--brand-navy-800)}
