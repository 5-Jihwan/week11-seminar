function snapZV(n){const el=document.querySelector(`.node[data-id="${n.id}"]`);if(!el)return false;const box=id=>{const x=document.querySelector(`.node[data-id="${id}"]`);return x?{x:x.offsetLeft,y:x.offsetTop,w:x.offsetWidth,h:x.offsetHeight}:null};
  const G=edgeGeoms(box),cx=el.offsetLeft+el.offsetWidth/2,cy=el.offsetTop+el.offsetHeight/2;let best=null,bd=48;st.edges.forEach(e=>{if(e.toEdge||badEdge(e)||!G[e.id])return;const d=Math.hypot(G[e.id].mx-cx,G[e.id].my-cy);if(d<bd){bd=d;best=e;}});
  if(!best)return false;n.y=Math.max(0,G[best.id].my-90);st.sel=n.id;attachZV(n.id,best.id);return true;}
function badEdge(e){const a=st.nodes.find(n=>n.id===e.from),b=st.nodes.find(n=>n.id===e.to);return !a||!b||a.role==="DV"||a.role==="ZV"||b.role==="ZV"||(a.role==="MV"&&b.role==="IV");}
function attachZV(zid,eid){const t=st.edges.find(x=>x.id===eid);if(!t||badEdge(t)){toast('역방향이나 조절 경로에는 붙일 수 없습니다');return;}st.edges=st.edges.filter(x=>x.from!==zid);st.edges.push({id:'e'+(++uid),from:zid,toEdge:eid});st.sel=null;touch();const a=st.nodes.find(n=>n.id===t.from),b=st.nodes.find(n=>n.id===t.to);toast(`${a.name} → ${b.name} 경로에 조절변수를 붙였습니다`);}
function tapNode(id){if(!st.sel){st.sel=id;draw();const z=st.nodes.find(n=>n.id===id);if(z&&z.role==="ZV")toast('조절변수입니다. 노란 손잡이를 클릭하거나 변수를 그 위로 끌어다 놓으세요');openDrawer('justify',id);return;}if(st.sel===id){st.sel=null;draw();return;}
  const z=st.nodes.find(n=>n.id===st.sel),tgt=st.nodes.find(n=>n.id===id);if(tgt&&tgt.role==="ZV"){toast('조절변수로는 화살표를 넣지 않습니다. 조절변수를 누르고 경로를 클릭하세요');st.sel=null;draw();return;}
  if(z&&z.role==="ZV"){const into=st.edges.filter(x=>!x.toEdge&&x.to===id&&(st.nodes.find(n=>n.id===x.from)||{}).role!=="ZV"&&!badEdge(x));if(into.length===1){attachZV(z.id,into[0].id);return;}toast(into.length?'이 변수로 들어오는 경로가 여럿입니다. 붙일 화살표를 직접 클릭하세요':'먼저 원인 → 결과 경로를 만든 뒤, 조절변수는 그 화살표를 클릭해 붙이세요');draw();return;}
  if(!st.edges.some(x=>x.from===st.sel&&x.to===id))st.edges.push({id:'e'+(++uid),from:st.sel,to:id});st.sel=null;touch();toast('경로 연결됨');}
function delNode(id){st.nodes=st.nodes.filter(x=>x.id!==id);const gone=new Set(st.edges.filter(x=>x.from===id||x.to===id).map(x=>x.id));st.edges=st.edges.filter(x=>x.from!==id&&x.to!==id&&!(x.toEdge&&gone.has(x.toEdge)));if(st.sel===id)st.sel=null;closeDrawer();touch();}
