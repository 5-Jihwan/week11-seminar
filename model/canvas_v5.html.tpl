function hyps(){const N=st.nodes,E=st.edges,h=[];let k=1;E.forEach(e=>{const a=N.find(n=>n.id===e.from);if(e.toEdge){const t=E.find(x=>x.id===e.toEdge),ta=t&&N.find(n=>n.id===t.from),tb=t&&N.find(n=>n.id===t.to);if(a&&ta&&tb)h.push(`H${k++}. ${ta.name}과(와) ${tb.name}의 관계는 ${a.name}에 따라 다를 것이다.`);return;}const b=N.find(n=>n.id===e.to);if(!a||!b||a.role==="DV"||a.role==="CV"||b.role==="CV")return;if(a.role==="ZV"){const ivs=N.filter(n=>n.role==="IV"&&E.some(x=>x.from===n.id&&x.to===b.id));(ivs.length?ivs:[{name:'원인'}]).forEach(i=>h.push(`H${k++}. ${i.name}과(와) ${b.name}의 관계는 ${a.name}에 따라 다를 것이다.`));return;}h.push(`H${k++}. ${a.name}은(는) ${b.name}와(과) 관련이 있을 것이다.`);});
  N.filter(n=>n.role==="MV").forEach(m=>{const ins=E.filter(e=>e.to===m.id).map(e=>N.find(n=>n.id===e.from)),out=E.find(e=>e.from===m.id);if(out)ins.forEach(a=>a&&a.role!=="ZV"&&h.push(`H${k++}. ${a.name}과(와) ${N.find(n=>n.id===out.to).name}의 관계를 ${m.name}이(가) 매개할 것이다.`));});return h;}
