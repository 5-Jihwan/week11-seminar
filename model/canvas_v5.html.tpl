RC={IV:["#1e3a5f","#eef4ff","#adc8f5"],MV:["#006a61","#e6fdf9","#6bd8cb"],DV:["#6d28d9","#f3e8ff","#c084fc"],ZV:["#92400e","#fef3c7","#f59e0b"],CV:["#374151","#f9fafb","#d1d5db"]};
