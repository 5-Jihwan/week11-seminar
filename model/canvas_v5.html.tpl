function renderPanel(){document.querySelectorAll('.ptab').forEach(b=>b.classList.toggle('active',b.dataset.p===st.ptab));const el=$('pcontent');
  if(st.ptab==='data'){const svs=Object.keys(S).filter(s=>IT.some(i=>i.survey===s&&okItem(i)&&cdim(i.concept)));el.innerHTML=`<div class="eyebrow">자료 · ${svs.length}</div>`+svs.map(s=>`<div class="surv ${st.survey===s?'on':''}" data-s="${s}"><b>${S[s].name}</b><small>${S[s].unit} · ${S[s].best_wave||''}</small><small>${S[s].why||''}</small></div>`).join('');
