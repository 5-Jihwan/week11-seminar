  if(st.ptab==='paper'){el.innerHTML=`<div class="eyebrow">1부 다섯 편이 사회자본을 잰 것</div>`+PAPERS.map(p=>`<div class="v2card"><div style="font-size:13px;font-weight:700;color:var(--brand-navy-800)">${p[0]}</div><div style="font-size:12px;margin-top:3px">${p[1]}</div><div style="font-size:11px;color:var(--ink-500);margin-top:3px">신뢰의 자리: ${p[2]}</div></div>`).join('');el.onclick=null;return;}
