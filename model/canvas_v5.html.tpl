function rolePop(x,y,i,cb){const p=$('pop');
  p.innerHTML=`<div class="e">이 문항의 역할</div><div class="n">${i.question.slice(0,60)}</div>`+ROLES.map(r=>`<button data-r="${r}" style="border-color:${RC[r][2]};background:${RC[r][1]};color:${RC[r][0]};${r==="DV"&&dvNode()?'opacity:.45':''}"><span class="c">${r}</span><span><b style="font-size:11.5px">${ROLE[r]}</b> <span style="font-size:9.5px;opacity:.7;margin-left:4px">${r==="DV"&&dvNode()?'이미 있음 → 그 변수 위에 놓으면 묶임':RDESC[r]}</span></span></button>`).join('')+`<button data-r="" style="border-color:transparent;color:var(--ink-400);background:transparent;justify-content:center">취소</button>`;
