  <textarea id="ctext" placeholder="예: 모르는 사람도 믿을 수 있다는 기대와, 어려울 때 도움을 주고받는 관계">${c.text}</textarea>
  <div class="eyebrow">어느 쪽에 가깝습니까</div><div class="opt" id="cdim">${[["cognitive","인지적","신뢰·규범·호혜의 기대"],["structural","구조적","연결망·단체 참여·접촉"],["both","둘 다","생각과 관계를 함께"]].map(([v,l,d])=>`<button data-v="${v}" class="${c.dim===v?'on':''}">${l}<small>${d}</small></button>`).join('')}</div>
  <div class="eyebrow">누구의 것입니까</div><div class="opt" id="clevel">${[["individual","개인의 자산","한 사람이 가진 신뢰·관계"],["collective","공동체의 속성","마을·지역·나라가 가진 것"]].map(([v,l,d])=>`<button data-v="${v}" class="${c.level===v?'on':''}">${l}<small>${d}</small></button>`).join('')}</div>
  <div style="display:flex;gap:8px;justify-content:flex-end"><button class="ghost" id="cback">자료 다시 고르기</button><button class="share" id="cgo" style="height:36px">문항 고르러 가기 ›</button></div></div>`;
  $('gate').onclick=e=>{const b=e.target.closest('button');if(!b)return;if(b.parentElement.id==='cdim'||b.parentElement.id==='clevel'){[...b.parentElement.children].forEach(x=>x.classList.toggle('on',x===b));return;}
