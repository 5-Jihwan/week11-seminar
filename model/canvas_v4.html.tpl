    <div class="vpanel" id="vpanel"><div class="vhead"><div><div class="t" id="vt">모형 검증</div><div class="s" id="vs"></div></div><button class="x" data-close="vpanel" style="border:0;background:none;color:#94a3b8"><span class="ms">close</span></button></div><div class="sum" id="vsum"></div><div class="vbody" id="vbody"></div></div>
    <div class="gate" id="gate"></div>
  </div>
  <div class="drawer"><div class="dpanel" id="dpanel"><div class="dhandle" id="dhandle"></div><div class="dhead"><span class="ms" id="dicon" style="color:var(--brand-navy-700);font-size:17px">psychology_alt</span><div class="t" id="dtitle"></div><span class="px" id="dpx">340px</span><button class="x" id="dclose"><span class="ms" style="font-size:15px">close</span></button></div><div class="dbody" id="dbody"></div></div>
      <div class="strip"><button class="sbtn" data-d="justify" title="변수"><span class="ms">psychology_alt</span><span class="l">변수</span></button><button class="sbtn" data-d="def" title="정의"><span class="ms">fingerprint</span><span class="l">정의</span></button><button class="sbtn" data-d="studies" title="선행연구"><span class="ms">collections_bookmark</span><span class="l">선행연구</span></button><button class="sbtn" data-d="review" title="리뷰"><span class="ms">rate_review</span><span class="l">리뷰</span></button></div></div>
  </div>
</div></div>
<div class="banner" id="banner"><span class="ms">auto_awesome</span><div class="bt"><div class="b1">연구 모형 완성됐나요?</div><div class="b2">확인하면 선행연구와 비교하고 가설을 제안해 드려요.</div></div><div style="display:flex;gap:8px"><button class="no" id="b-no">아직요</button><button class="go" id="b-go">선행연구 비교</button></div></div>
<div class="toast" id="toast"></div><div class="pop" id="pop"></div>
<script>
// SAVE_URL: backend/apps-script.gs를 웹앱으로 배포한 주소(비우면 이 브라우저 localStorage만). DEMO=false면 verified=TRUE 선행연구만 보인다(가드레일 2).
const CAT=__CAT__, REV=__REV__, PAPERS=__PAPERS__, STUDIES=__STUDIES__, SAVE_URL="", DEMO=true;
const S=CAT.surveys, C=CAT.concepts, IT=CAT.items;
const ROLE={DV:"종속변수",IV:"독립변수",MV:"매개변수",CV:"통제변수"},RDESC={IV:"원인이 되는 변수",MV:"인과를 전달하는 변수",DV:"결과가 되는 변수",CV:"연결 없이 배치됨"},RC={IV:["#1e3a5f","#eef4ff","#adc8f5"],MV:["#006a61","#e6fdf9","#6bd8cb"],DV:["#6d28d9","#f3e8ff","#c084fc"],CV:["#374151","#f9fafb","#d1d5db"]};
const COMP_OF={trust_general:"generalized_trust",trust_social:"generalized_trust",trust_neighbor:"neighbor_trust",trust_institution:"institutional_trust",participation:"participation",volunteer_donate:"volunteer_donate",network_reciprocity:"reciprocity",political_participation:"political_participation"};
const COMP_KO={generalized_trust:"일반신뢰",institutional_trust:"기관신뢰",neighbor_trust:"이웃 신뢰",participation:"단체 참여",volunteer_donate:"봉사·기부",network:"연결망",reciprocity:"호혜",political_participation:"정치 참여"};
const PAPER_OF={trust_general:"K&R 0~10 단일 문항",trust_social:"K&R 변형(대상이 사회)",trust_neighbor:"Krishna 마을 신뢰",trust_institution:"Krishna의 독립변수(정부 신뢰)",participation:"Freitag 4문항 / Mettler 가입 수",volunteer_donate:"Mettler 시민참여",network_reciprocity:"Krishna 6문항",political_participation:"Mettler 6종",fairness:"K&R 매개(받을 자격이 있는 것을 받았나)",welfare_selective:"K&R 선별 7기관",welfare_universal:"K&R 보편 10기관 / Mettler G.I. Bill",public_service_experience:"L&W 반응성",institution_participation:"Freitag 직접민주주의 / L&W 참여 기회",region:"Freitag 칸톤·언어권"};
const okItem=i=>!(i.concept==='region'&&/확인 필요|소속감/.test(i.question||''));
const $=id=>document.getElementById(id),cname=id=>(C.find(c=>c.id===id)||{}).label||id,sname=k=>(S[k]||{}).name||k,crole=id=>(C.find(c=>c.id===id)||{}).role,roleOf=i=>crole(i.concept)==='dv'?'dv':crole(i.concept)==='med'?'mv':'iv';
let st={survey:null,nodes:[],edges:[],sel:null,q:"",ptab:"items",zones:false},uid=0,idle=null,bannerDone=false;
const comps=n=>[...new Set(n.items.map(k=>COMP_OF[IT[k].concept]).filter(Boolean))],dvNode=()=>st.nodes.find(n=>n.role==="DV"),dvComps=()=>{const d=dvNode();return d?comps(d):[]},nodeConcepts=n=>[...new Set(n.items.map(k=>IT[k].concept))];
const defLine=()=>{const d=dvNode();if(!d||!d.items.length)return'';const its=d.items.map(k=>IT[k]),cs={};its.forEach(i=>(cs[i.concept]=cs[i.concept]||0,cs[i.concept]++));return `${/^(내|나의)/.test(d.name)?'':'당신의 '}${d.name} = ${sname(st.survey)} ${its[0].wave||''} · ${Object.entries(cs).map(([c,n])=>cname(c)+(n>1?' '+n+'문항':'')).join(' + ')} · ${[...new Set(its.map(i=>i.unit).filter(Boolean))].join('·')||'개인'} 단위`};
function toast(t){const e=$('toast');e.textContent=t;e.classList.add('on');clearTimeout(e._t);e._t=setTimeout(()=>e.classList.remove('on'),2200);}
/* ── 자료 게이트 ── */
function gate(){const svs=Object.keys(S).filter(s=>IT.some(i=>i.survey===s&&okItem(i)));
  $('gate').innerHTML=`<div class="gcard"><div class="e">STEP 1 · 자료</div><h2>어떤 자료로 연구하시겠습니까</h2><p>조사를 고르면 그 조사의 문항만 팔레트에 보입니다. 같은 사람에게 물은 문항끼리만 한 모형에 들어갑니다. 1부 다섯 편도 각자 다른 자료에서 각자 다르게 사회자본을 정의했습니다.</p><div class="ggrid">`+
  svs.map(s=>{const its=IT.filter(i=>i.survey===s&&okItem(i));return `<div class="surv" data-s="${s}"><b>${S[s].name}</b><small>${S[s].unit} · ${S[s].best_wave||''}</small><small>사회자본 ${its.filter(i=>crole(i.concept)==='dv').length} · 원인 ${its.filter(i=>crole(i.concept)==='iv').length} · 매개 ${its.filter(i=>crole(i.concept)==='med').length} · 지역 ${its.filter(i=>i.concept==='region').length}</small><small>${S[s].why||''}</small></div>`}).join('')+`</div></div>`;
  $('gate').onclick=e=>{const b=e.target.closest('.surv');if(!b)return;pickSurvey(b.dataset.s);};$('gate').style.display='flex';}
function pickSurvey(s){st.survey=s;st.nodes=[];st.edges=[];st.sel=null;$('gate').style.display='none';st.ptab='items';renderPanel();draw();toast(`${sname(s)} 문항 ${IT.filter(i=>i.survey===s&&okItem(i)).length}개 로드됨`);}
/* ── 왼쪽 패널 ── */
function renderPanel(){document.querySelectorAll('.ptab').forEach(b=>b.classList.toggle('active',b.dataset.p===st.ptab));const el=$('pcontent');
  if(st.ptab==='data'){const svs=Object.keys(S).filter(s=>IT.some(i=>i.survey===s&&okItem(i)));el.innerHTML=`<div class="eyebrow">자료 · ${svs.length}</div>`+svs.map(s=>`<div class="surv ${st.survey===s?'on':''}" data-s="${s}"><b>${S[s].name}</b><small>${S[s].unit} · ${S[s].best_wave||''}</small><small>${S[s].why||''}</small></div>`).join('');
    el.onclick=e=>{const b=e.target.closest('.surv');if(b&&b.dataset.s!==st.survey&&(!st.nodes.length||confirm('자료를 바꾸면 캔버스가 비워집니다.')))pickSurvey(b.dataset.s);};return;}
  if(st.ptab==='paper'){el.innerHTML=`<div class="eyebrow">1부 다섯 편이 사회자본을 잰 것</div>`+PAPERS.map(p=>`<div class="v2card"><div style="font-size:13px;font-weight:700;color:var(--brand-navy-800)">${p[0]}</div><div style="font-size:12px;margin-top:3px">${p[1]}</div><div style="font-size:11px;color:var(--ink-500);margin-top:3px">신뢰의 자리: ${p[2]}</div></div>`).join('');el.onclick=null;return;}
  if(!st.survey){el.innerHTML=`<div class="hintbox">먼저 자료를 고르십시오.</div>`;return;}
  const its=IT.map((i,k)=>({i,k})).filter(x=>x.i.survey===st.survey&&okItem(x.i)),used=new Set(st.nodes.flatMap(n=>n.items));
  const groups=[["사회자본 후보 — 끌어다 놓고 묶으십시오",x=>crole(x.i.concept)==='dv'],["원인 후보",x=>crole(x.i.concept)==='iv'],["매개 후보",x=>crole(x.i.concept)==='med'],["지역",x=>x.i.concept==='region']];
  el.innerHTML=`<div class="hintbox"><span class="ms" style="font-size:12px;vertical-align:middle;margin-right:4px">touch_app</span>카드를 캔버스로 끌어다 놓으면 변수가 생기고, 변수 위에 놓으면 그 변수에 묶입니다.</div>`+groups.map(([h,f])=>{const g=its.filter(f);return g.length?`<div class="eyebrow">${h} · ${g.length}</div>`+g.map(x=>`<div class="vcard ${used.has(x.k)?'used':''}" data-k="${x.k}"><div class="vbadge ${roleOf(x.i)}">${roleOf(x.i).toUpperCase()}</div><div class="vname">${x.i.question}<span class="vtag">${cname(x.i.concept)} · ${x.i.wave||''} · ${x.i.scale||''}${x.i.unit?' · '+x.i.unit:''}</span></div></div>`).join(''):''}).join('')+`<div class="eyebrow">개인 특성</div><div class="vcard used"><div class="vbadge">CV</div><div class="vname">연령 · 교육 · 소득 · 고용<span class="vtag">모든 모형에 통제로 들어갑니다</span></div></div><div style="font-size:9.5px;color:var(--ink-300);text-align:center;margin-top:12px;font-family:var(--font-mono)">${its.length}개 문항 · ${used.size}개 배치됨</div>`;el.onclick=null;}
document.querySelectorAll('.ptab').forEach(b=>b.onclick=()=>{st.ptab=b.dataset.p;renderPanel();});
$('mobtog').onclick=()=>$('lpanel').classList.toggle('open');
/* 왼쪽 패널 리사이즈 */
let rs=null;$('rhandle').addEventListener('pointerdown',e=>{rs={x:e.clientX,w:$('lpanel').offsetWidth};$('rhandle').classList.add('on');document.body.style.cursor='col-resize';});
document.addEventListener('pointermove',e=>{if(rs){$('lpanel').style.width=Math.min(520,Math.max(220,rs.w+e.clientX-rs.x))+'px';draw(false);}if(ds){const w=Math.min(700,Math.max(260,ds.w+(ds.x-e.clientX)));$('dpanel').style.width=w+'px';$('dpx').textContent=w+'px';draw(false);}
  if(drag){drag.moved=true;drag.g.style.left=e.clientX+8+'px';drag.g.style.top=e.clientY+8+'px';hover(e.clientX,e.clientY);}
  if(mv){if(Math.hypot(e.clientX-mv.x0,e.clientY-mv.y0)>6)mv.moved=true;if(mv.moved){const r=$('cv').getBoundingClientRect();mv.n.x=Math.max(0,Math.min(r.width-130,e.clientX-r.left-mv.dx));mv.n.y=Math.max(0,Math.min(r.height-50,e.clientY-r.top-mv.dy));draw(false);}}});
document.addEventListener('pointerup',e=>{if(rs){rs=null;$('rhandle').classList.remove('on');document.body.style.cursor='';}if(ds){ds=null;$('dhandle').classList.remove('on');$('dpanel').classList.remove('drag');document.body.style.cursor='';}
  if(drag){drag.g.remove();const k=drag.k,moved=drag.moved;drag=null;clearHover();const t=nodeAt(e.clientX,e.clientY),r=$('cv').getBoundingClientRect(),inCv=e.clientX>r.left&&e.clientX<r.right&&e.clientY>r.top&&e.clientY<r.bottom;
    if(t&&t.role!=="CV"){t.items.push(k);touch();openDrawer('justify',t.id);toast(`"${IT[k].question.slice(0,18)}…" → ${t.name}에 묶임`);}else if(inCv&&moved){const i=IT[k];rolePop(e.clientX,e.clientY,i,role=>newNode(k,role,{x:e.clientX-r.left-60,y:e.clientY-r.top-20}));}$('lpanel').classList.remove('open');return;}
  if(mv){const n=mv.n,moved=mv.moved;mv=null;if(!moved)tapNode(n.id);else touch();}});
/* ── 끌기 ── */
let drag=null,mv=null;
$('pcontent').addEventListener('pointerdown',e=>{const c=e.target.closest('.vcard');if(!c||c.classList.contains('used')||c.dataset.k==null)return;e.preventDefault();drag={k:+c.dataset.k,moved:false};const g=document.createElement('div');g.className='ghostcard';g.textContent=IT[drag.k].question.slice(0,36)+'…';document.body.appendChild(g);drag.g=g;g.style.left=e.clientX+8+'px';g.style.top=e.clientY+8+'px';});
function nodeAt(cx,cy){const r=$('cv').getBoundingClientRect();return st.nodes.find(n=>{const el=document.querySelector(`.node[data-id="${n.id}"]`);if(!el)return false;const b=el.getBoundingClientRect();return cx>=b.left&&cx<=b.right&&cy>=b.top&&cy<=b.bottom;});}
function hover(cx,cy){const t=nodeAt(cx,cy);document.querySelectorAll('.node').forEach(el=>el.classList.toggle('over',!!t&&el.dataset.id===t.id&&t.role!=="CV"));}function clearHover(){document.querySelectorAll('.node.over').forEach(el=>el.classList.remove('over'));}
function rolePop(x,y,i,cb){const p=$('pop'),roles=crole(i.concept)==='dv'?(dvNode()?["IV","DV","MV"]:["DV","IV","MV"]):crole(i.concept)==='med'?["MV","IV","DV"]:["IV","MV","CV"];
  p.innerHTML=`<div class="e">변수 역할 선택</div><div class="n">${i.question.slice(0,60)}</div>`+roles.map(r=>`<button data-r="${r}" style="border-color:${RC[r][2]};background:${RC[r][1]};color:${RC[r][0]}"><span class="c">${r}</span><span><b style="font-size:11.5px">${ROLE[r]}</b> <span style="font-size:9.5px;opacity:.7;margin-left:4px">${RDESC[r]}</span></span></button>`).join('')+`<button data-r="" style="border-color:transparent;color:var(--ink-400);background:transparent;justify-content:center">취소</button>`;
  p.style.left=Math.min(x,window.innerWidth-270)+'px';p.style.top=Math.max(8,Math.min(y-40,window.innerHeight-280))+'px';p.classList.add('on');
  p.onclick=ev=>{const b=ev.target.closest('button');if(!b)return;p.classList.remove('on');if(b.dataset.r)cb(b.dataset.r);};}
function newNode(k,role,pos){if(role==="DV"&&dvNode()){toast('종속변수는 하나만. 기존 종속변수의 역할을 바꾸십시오.');return;}const i=IT[k],n={id:'n'+(++uid),name:cname(i.concept),role,items:[k],x:Math.max(0,pos.x),y:Math.max(0,pos.y)};st.nodes.push(n);touch();openDrawer('justify',n.id);}
