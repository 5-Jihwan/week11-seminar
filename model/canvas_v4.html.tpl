/* ── 검증·계보·매칭·리뷰·가설 (v3와 같은 규칙) ── */
function validate(){const o=[],N=st.nodes,E=st.edges;if(!N.length)return o;const dv=N.filter(n=>n.role==="DV"),iv=N.filter(n=>n.role==="IV");
  if(!dv.length)o.push({l:'err',m:'종속변수(DV)가 없습니다.',d:'사회자본으로 쓸 문항을 묶은 변수를 종속변수로 두십시오. 1부 다섯 편도 여기서 갈렸습니다.',s:'변수를 클릭 → 역할 DV'});
  if(!iv.length)o.push({l:'err',m:'독립변수(IV)가 없습니다.',d:'무엇이 그것을 바꾼다고 보는지 하나 이상.'});
  if(N.length>=2&&!E.length)o.push({l:'warn',m:'경로가 없습니다.',d:'변수를 누르고 다른 변수를 누르면 이어집니다.'});
  N.filter(n=>!n.items.length).forEach(n=>o.push({l:'err',m:`${n.name}에 문항이 없습니다.`,d:'팔레트에서 문항을 끌어다 이 변수 위에 놓으십시오.'}));
  dv.forEach(d=>{const mixed=nodeConcepts(d).filter(c=>crole(c)!=='dv');if(mixed.length)o.push({l:'warn',m:`${d.name}에 사회자본이 아닌 문항이 섞여 있습니다: ${mixed.map(cname).join(', ')}`,d:'종속변수 정의에는 사회자본 문항만.',s:'원인 문항은 따로 변수로'});});
  const units=[...new Set(N.flatMap(n=>n.items).map(k=>IT[k].unit).filter(Boolean))];if(units.length>1)o.push({l:'warn',m:`단위가 다릅니다: ${units.join(' / ')}`,d:'가구 수급을 가구원 신뢰에 붙이는 결정이 필요합니다(spotlight ①).'});
  E.forEach(e=>{const a=N.find(n=>n.id===e.from),b=N.find(n=>n.id===e.to);if(!a||!b)return;if(a.role==="DV")o.push({l:'err',m:`역방향 경로: ${a.name}(DV) → ${b.name}`,d:'종속변수에서 나가는 화살표는 역인과 가설입니다. 5장 저자도 "반대는 늘 가능하다"고 썼지만 모형에는 한 방향만.',s:`${b.name} → ${a.name}로 바꾸십시오`});
    if(a.role==="MV"&&b.role==="IV")o.push({l:'err',m:`${a.name}(MV) → ${b.name}(IV): 매개가 원인을 가리킵니다.`,d:'IV → MV → DV 순서로.'});if(a.role==="IV"&&b.role==="IV")o.push({l:'warn',m:`${a.name} → ${b.name}: 독립변수끼리 이었습니다.`,d:'둘 중 하나를 매개로 바꾸거나 경로를 지우십시오.'});});
  const conn=new Set(E.flatMap(e=>[e.from,e.to]));N.filter(n=>n.role!=="CV"&&!conn.has(n.id)).forEach(n=>o.push({l:'warn',m:`'${n.name}'이(가) 고립되어 있습니다.`,d:'경로가 없는 변수는 모형 밖입니다.'}));
  N.filter(n=>n.role==="MV").forEach(m=>{if(!E.some(e=>e.to===m.id)||!E.some(e=>e.from===m.id))o.push({l:'warn',m:`${m.name}은 매개인데 들어오는 경로와 나가는 경로가 다 있어야 합니다.`,d:'IV → MV, MV → DV 둘 다.'});});return o;}
function ivConcepts(){return [...new Set(st.nodes.filter(n=>n.role==="IV").flatMap(nodeConcepts))];}function medConcept(){const m=st.nodes.find(n=>n.role==="MV");return m?(nodeConcepts(m)[0]||null):null;}
function dvConcept(){const d=dvNode();if(!d)return null;const cs=comps(d);return cs.some(c=>/trust/.test(c))?(cs.includes('neighbor_trust')&&!cs.includes('generalized_trust')?'trust_neighbor':'trust_general'):cs.some(c=>/participation|volunteer/.test(c))?'participation':cs.length?'network_reciprocity':null;}
function lineage(){const dv=dvConcept(),iv=ivConcepts(),med=medConcept();if(!dv)return null;const T=['trust_general','trust_social','trust_institution','trust_neighbor'],P=['participation','volunteer_donate','political_participation'],has=g=>iv.includes(g),wel=has('welfare_selective')||has('welfare_universal');
  if(['trust_general','trust_social'].includes(dv)&&wel)return['복지국가 설계가 신뢰를 만들고 부순다','5장 K&R'];if(T.includes(dv)&&dv!=='trust_neighbor'&&has('public_service_experience')&&med==='fairness')return['접촉의 공정성이 신뢰로','5장 K&R 매개'];
  if(P.includes(dv)&&(has('institution_participation')||has('region')))return['참여 제도가 결사체를 키운다','2장 Freitag'];if(P.includes(dv)&&has('welfare_universal'))return['정책 수혜가 참여를 만든다','4장 Mettler'];if(P.includes(dv)&&has('welfare_selective'))return['Mettler의 반대 설계(심사형)','4장 Mettler · 5장 K&R 교차'];
  if(['network_reciprocity','trust_neighbor'].includes(dv)&&(has('region')||has('public_service_experience')))return['지역 맥락이 협력 성향을 만든다','1장 Krishna'];if(has('institution_participation')&&(med==='fairness'||med==='trust_institution'))return['반응하는 제도가 사회자본을 꺼낸다','3장 L&W'];
  if(dv==='trust_institution'&&has('public_service_experience'))return['서비스 경험이 기관신뢰로','5장 K&R 기제 1(일선 관료)'];if(T.includes(dv)&&has('institution_participation'))return['Freitag의 종속변수를 신뢰로 바꾼 조합. Freitag은 신뢰를 재지 않았다','2장 밖'];
  if(['network_reciprocity','trust_neighbor'].includes(dv)&&wel)return["K&R의 독립변수에 Krishna의 종속변수",'1·5장 밖'];
  const cs=dvComps();if(cs.some(c=>/reciprocity|neighbor|network/.test(c))&&(has('region')||has('public_service_experience')))return['신뢰와 호혜를 함께 묶은 Krishna식 정의, 지역·서비스 맥락이 원인','1장 Krishna 변형'];
  if(T.includes(dv)&&has('public_service_experience'))return['서비스 접촉이 신뢰로. K&R이 매개로 둔 공정성이 빠져 있다','5장 K&R 변형'];return['1부 다섯 편 밖의 조합','밖'];}
function match(){const cs=dvComps();if(!cs.length)return[];const iv=ivConcepts(),med=!!st.nodes.find(n=>n.role==="MV"),myUnit=iv.includes('region')&&st.survey==='chs'?'region':'individual',myInst=iv.some(g=>/welfare|public_service|institution/.test(g)),myReg=iv.includes('region');
  const linMap={'5장 K&R':'kr','5장 K&R 매개':'kr','5장 K&R 기제 1(일선 관료)':'kr','5장 K&R 변형':'kr','2장 Freitag':'freitag','3장 L&W':'lw','4장 Mettler':'mettler','4장 Mettler · 5장 K&R 교차':'mettler','1장 Krishna':'krishna','1장 Krishna 변형':'krishna'},myLin=linMap[(lineage()||[])[1]]||null;
  return STUDIES.filter(s=>DEMO||s.ok).map(s=>{const inter=s.comps.filter(c=>cs.includes(c)),uni=[...new Set([...s.comps,...cs])];let sc=3*inter.length/uni.length;if(s.unit===myUnit||s.unit==='mixed')sc+=1;if(myInst&&s.inst)sc+=1;if(myReg&&s.reg)sc+=1;if(med&&s.med)sc+=1;if(myLin&&s.lin===myLin)sc+=1.5;return {s,sc,inter,only:s.comps.filter(c=>!cs.includes(c)),miss:cs.filter(c=>!s.comps.includes(c))};}).filter(x=>x.inter.length).sort((a,b)=>b.sc-a.sc).slice(0,5);}
function topFor(cs){const m=STUDIES.filter(s=>DEMO||s.ok).map(s=>{const inter=s.comps.filter(c=>cs.includes(c)),uni=[...new Set([...s.comps,...cs])];return {s,sc:3*inter.length/uni.length+(s.unit==='individual'||s.unit==='mixed'?1:0),inter};}).filter(x=>x.inter.length).sort((a,b)=>b.sc-a.sc)[0];return m?`${m.s.au} (${m.s.y})`:'없음';}
function altDefs(){const d=dvNode();if(!d||!d.items.length)return[];const out=[],cs=comps(d),now=topFor(cs),compsOf=ks=>[...new Set(ks.map(k=>COMP_OF[IT[k].concept]).filter(Boolean))];
  if(d.items.length>1){const k=d.items[d.items.length-1],c2=compsOf(d.items.filter(x=>x!==k));out.push({t:`「${IT[k].question.slice(0,28)}…」을 빼면`,d:`구성 요소 ${c2.map(c=>COMP_KO[c]).join('·')||'—'} → 닮은 연구 1위 ${topFor(c2)}${topFor(c2)===now?' (그대로)':''}`});}
  const extra=IT.map((i,k)=>({i,k})).find(x=>x.i.survey===st.survey&&crole(x.i.concept)==='dv'&&!d.items.includes(x.k)&&!cs.includes(COMP_OF[x.i.concept]));if(extra){const c2=compsOf([...d.items,extra.k]);out.push({t:`「${extra.i.question.slice(0,28)}…」을 더하면`,d:`구성 요소 ${c2.map(c=>COMP_KO[c]).join('·')} → 닮은 연구 1위 ${topFor(c2)}${topFor(c2)===now?' (그대로)':''}`});}
  const c0=IT[d.items[0]].concept,other=IT.find(i=>i.concept===c0&&i.survey!==st.survey&&okItem(i));if(other){const i0=IT[d.items[0]];out.push({t:`같은 ${cname(c0)}을 ${sname(other.survey)}로 재면`,d:`${i0.scale||'척도 미상'}(${i0.unit||'개인'}) → ${other.scale||'척도 미상'}(${other.unit||S[other.survey].unit}) · ${other.wave||''}. 같은 이름, 다른 조작적 정의입니다.`});}return out;}
function review(){const sv=st.survey;if(!sv||!dvNode())return[];const dv=dvConcept(),iv=ivConcepts(),med=medConcept(),o=[];const b=REV.base[sv];if(b)o.push(['약한 고리',b[0]],['한 단계',b[1]]);const c=Object.fromEntries(REV.cond),add=k=>o.push(['덧붙임',c[k]]);
  if(med)add('med_any');if(med==='fairness'&&sv==='kipa')add('med_fair_kipa');if(dv==='trust_institution')add('dv_inst');if(iv.includes('welfare_selective')&&sv==='koweps')add('iv_sel_koweps');if(iv.includes('welfare_selective')&&sv==='chs')add('iv_sel_chs');if(iv.includes('institution_participation')&&sv==='kipa')add('iv_inst_kipa');
  if(iv.includes('region'))add(sv==='chs'?'region_sgg':'region_wide');if(/영향/.test(st.q))add('q_cause');if(dv==='trust_neighbor'&&(iv.includes('welfare_selective')||iv.includes('welfare_universal')))add('neighbor_welfare');return o;}
function hyps(){const N=st.nodes,E=st.edges,h=[];let k=1;E.forEach(e=>{const a=N.find(n=>n.id===e.from),b=N.find(n=>n.id===e.to);if(!a||!b||a.role==="DV")return;h.push(`H${k++}. ${a.name}은(는) ${b.name}와(과) 관련이 있을 것이다.`);});N.filter(n=>n.role==="MV").forEach(m=>{const ins=E.filter(e=>e.to===m.id).map(e=>N.find(n=>n.id===e.from)),out=E.find(e=>e.from===m.id);if(out)ins.forEach(a=>a&&h.push(`H${k++}. ${a.name}과(와) ${N.find(n=>n.id===out.to).name}의 관계를 ${m.name}이(가) 매개할 것이다.`));});return h;}
const B=t=>t.replace(/\((\d장[^)]*)\)/g,'(<b style="color:var(--brand-navy-700)">$1</b>)');
/* ── 제출 ── */
function submit(){if($('submit').disabled)return;const d=dvNode(),row={ts:new Date().toISOString(),nick:$('nick').value.trim()||('익명'+Math.floor(Math.random()*900+100)),stage:'model',key:'submit',
  value:{survey:st.survey,dv:dvConcept(),dv_name:d.name,definition:defLine(),comps:dvComps(),iv:ivConcepts(),med:medConcept(),nodes:st.nodes.map(n=>({id:n.id,name:n.name,role:n.role,items:n.items,x:n.x,y:n.y})),edges:st.edges,q:st.q,lineage:(lineage()||[])[1],lineage_t:(lineage()||[])[0],matches:match().map(x=>({id:x.s.id,au:x.s.au,y:x.s.y,t:x.s.t})),hyps:hyps()}};
  try{const a=JSON.parse(localStorage.getItem('w11_model')||'[]');a.push(row);localStorage.setItem('w11_model',JSON.stringify(a));}catch(e){}if(SAVE_URL)fetch(SAVE_URL,{method:'POST',mode:'no-cors',body:JSON.stringify(row)}).catch(()=>{});
  toast(`"${row.nick}" 제출 완료 ☁ 대시보드에 올라갔습니다`);$('submit').disabled=true;$('submit').innerHTML='<span class="ms" style="font-size:13px">check</span>제출됨';}
$('submit').onclick=submit;
gate();renderPanel();draw();
</script></div></body></html>
