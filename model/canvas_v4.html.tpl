$('nodes').addEventListener('pointerdown',e=>{const el=e.target.closest('.node');if(!el)return;if(e.target.closest('.del'))return;const n=st.nodes.find(x=>x.id===el.dataset.id),r=$('cv').getBoundingClientRect();mv={n,dx:e.clientX-r.left-n.x,dy:e.clientY-r.top-n.y,x0:e.clientX,y0:e.clientY,moved:false};});
